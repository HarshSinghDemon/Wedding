rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidWish(data) {
      return data.keys().hasAll(['name', 'message'])
        && data.keys().hasOnly(['name', 'relation', 'message', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
        && (!('relation' in data) || (data.relation is string && data.relation.size() <= 100));
    }

    function isValidSongSuggestion(data) {
      return data.keys().hasAll(['songTitle', 'suggestedBy'])
        && data.keys().hasOnly(['songTitle', 'artist', 'suggestedBy', 'createdAt'])
        && data.songTitle is string && data.songTitle.size() >= 1 && data.songTitle.size() <= 150
        && data.suggestedBy is string && data.suggestedBy.size() >= 1 && data.suggestedBy.size() <= 100
        && (!('artist' in data) || (data.artist is string && data.artist.size() <= 150));
    }

    match /wishes/{wishId} {
      allow read, list: if true;
      allow create: if isValidWish(request.resource.data);
      allow update, delete: if false;
    }

    match /song_suggestions/{songId} {
      allow read, list: if true;
      allow create: if isValidSongSuggestion(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
